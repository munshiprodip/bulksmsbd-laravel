{
    "name": "munshiprodip/bulksmsbd-laravel",
    "description": "Clean, modern, PSR-12 compliant Laravel wrapper package for the BulkSMSBD SMS Gateway API",
    "type": "library",
    "keywords": [
        "laravel",
        "bulksmsbd",
        "sms",
        "sms-gateway",
        "bangladesh-sms",
        "otp",
        "package"
    ],
    "homepage": "https://github.com/munshiprodip/bulksmsbd-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Prodip Munshi",
            "email": "munshiprodip@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/http": "^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0|^11.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "BulkSmsBd\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BulkSmsBd\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BulkSmsBd\\Laravel\\BulkSmsBdServiceProvider"
            ],
            "aliases": {
                "BulkSmsBd": "BulkSmsBd\\Laravel\\Facades\\BulkSmsBd"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
